# Insert inside your existing HTTPS server block after configuring a trusted
# certificate. Use location / for a root deployment or /memo/ for that prefix;
# VOICE_MEMO_PUBLIC_URL must match the public HTTPS host/port and exact prefix.
# The upstream intentionally has no URI suffix, so Nginx preserves the prefix.
location /memo/ {
    client_max_body_size 2147483646;
    client_body_timeout 120s;
    proxy_pass http://127.0.0.1:8765;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;
    proxy_next_upstream off;
    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    access_log off;
}

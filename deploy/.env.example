# Deployment metadata only. Copy to private/deploy/relay.env; do not source it.
# Required: immutable image ID/digest and actual public HTTPS base URL.
VOICE_MEMO_IMAGE=sha256:REPLACE_WITH_BUILT_IMAGE_ID
VOICE_MEMO_PUBLIC_URL=https://relay.example.invalid

# Defaults can be omitted. Keep the project name stable; it selects persistent volumes.
VOICE_MEMO_PROJECT=voice-memo
# VOICE_MEMO_PORT=8765
# Optional bundled HTTPS proxy (otherwise use nginx-existing.conf.example).
# VOICE_MEMO_PROXY=1
# VOICE_MEMO_TLS_DIR=./private/deploy/tls
# VOICE_MEMO_HTTPS_BIND=127.0.0.1
# VOICE_MEMO_HTTPS_PORT=8443
# If the default 172.30.86.0/24 conflicts, change the complete address group:
# VOICE_MEMO_SUBNET=172.30.86.0/24
# VOICE_MEMO_GATEWAY=172.30.86.1
# VOICE_MEMO_RELAY_IP=172.30.86.2
# VOICE_MEMO_PROXY_IP=172.30.86.3
# VOICE_MEMO_DRAIN_TIMEOUT=1800
# API keys, device credentials and administrator password go in the HTTPS admin page.
